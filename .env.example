# .env.example — 로컬 환경변수 템플릿. 복사해서 .env로 만들고 값을 채운다.
#   cp .env.example .env   (그리고 .env에 실제 키 입력 — .env는 커밋 금지)
# env_loader.load_env()가 진입점(rag_server.py/rag_try.py/collect_public_kb.py)에서 자동 주입.

# OpenAI (LLM 분류·생성·임베딩). 라이브 경로에 필요.
OPENAI_API_KEY=

# (선택) OpenAI 호환 베이스 URL — 미설정 시 공식 엔드포인트
# OPENAI_API_BASE=https://api.openai.com

# (선택) 모델 오버라이드 — 미설정 시 기본 gpt-5.4-mini
# RAG_LLM_MODEL=gpt-5.4-mini
# RAG_LLM_FALLBACK_MODEL=gpt-5.4-mini

# (선택) PostgreSQL — 라이브 검색(hybrid_search)에 필요
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# (선택) 공공 KB 수집기 키
# KDCA_API_KEY=
# DATA_GO_KR_KEY=
